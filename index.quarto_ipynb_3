    "  f <- 67\n",
    "  for (k in 2:5) f[k] <- a*x[k] + (1-a)*f[k-1]\n",
    "  x[2:6] - f[1:5] }\n",
    "for (a in c(0.2, 0.4, 0.6, 0.8)) {\n",
    "  e <- err(a)\n",
    "  cat(\"a\", a, \" MSE\", round(mean(e^2), 1),\n",
